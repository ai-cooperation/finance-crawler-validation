{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finance-crawler.example/schemas/financial-depth.schema.json",
  "title": "Financial depth for professional research",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "time_series", "fundamentals", "valuation", "scenarios", "source_conflicts"],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "enum": ["professional_ready", "professional_partial", "research_only", "blocked"] },
    "time_series": { "$ref": "#/$defs/time_series" },
    "benchmark_time_series": { "anyOf": [{ "$ref": "#/$defs/time_series" }, { "type": "null" }] },
    "fundamentals": { "$ref": "#/$defs/data_status" },
    "valuation": { "$ref": "#/$defs/data_status" },
    "scenarios": { "type": "object", "additionalProperties": true },
    "source_conflicts": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "market_drivers": { "type": "object", "additionalProperties": true },
    "event_alignment": { "type": "object", "additionalProperties": true },
    "evidence_pack": { "$ref": "https://finance-crawler.example/schemas/canonical-evidence.schema.json" },
    "evidence_pack_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pack_id",
        "schema_version",
        "status",
        "item_count",
        "canonical_story_count",
        "duplicate_item_count",
        "source_group_count",
        "independent_publisher_count"
      ],
      "properties": {
        "pack_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "schema_version": { "const": 1 },
        "status": { "enum": ["available", "insufficient_data", "blocked"] },
        "item_count": { "type": "integer", "minimum": 0 },
        "canonical_story_count": { "type": "integer", "minimum": 0 },
        "duplicate_item_count": { "type": "integer", "minimum": 0 },
        "source_group_count": { "type": "integer", "minimum": 0 },
        "independent_publisher_count": { "type": "integer", "minimum": 0 }
      }
    },
    "quality_gate": { "$ref": "https://finance-crawler.example/schemas/quality-gate.schema.json" }
  },
  "$defs": {
    "time_series": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "status", "series_id", "provider", "currency", "as_of", "point_count", "points", "returns", "source_item_ids", "missing_reason"],
      "properties": {
        "schema_version": { "const": 1 },
        "status": { "enum": ["available", "insufficient_data", "unavailable"] },
        "series_id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "currency": { "type": ["string", "null"] },
        "as_of": { "type": "string", "format": "date-time" },
        "point_count": { "type": "integer", "minimum": 0 },
        "points": { "type": "array" },
        "returns": { "type": "object", "required": ["observed_pct"], "additionalProperties": true },
        "source_item_ids": { "type": "array", "items": { "type": "string" } },
        "missing_reason": { "type": ["string", "null"] }
      }
    },
    "data_status": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["available", "insufficient_data", "not_applicable", "unavailable"] }
      }
    }
  }
}
