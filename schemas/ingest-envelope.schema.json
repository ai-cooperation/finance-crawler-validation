{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finance-crawler.example/schemas/ingest-envelope.schema.json",
  "title": "GitHub Actions ingest envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "run_id",
    "workflow_run_id",
    "commit_sha",
    "snapshot_id",
    "source_manifest_hash",
    "collected_at",
    "items",
    "checkpoints"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "operation": { "const": "upsert_items" },
    "run_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{7,127}$" },
    "workflow_run_id": { "type": "string", "pattern": "^[0-9]{1,32}$" },
    "commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "snapshot_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{7,127}$" },
    "source_manifest_hash": { "$ref": "#/$defs/sha256" },
    "collected_at": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "type": "object" }
    },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/checkpoint" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "status", "last_successful_crawl", "last_article_date", "cursor"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "status": { "enum": ["success", "partial", "failed"] },
        "last_successful_crawl": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "last_article_date": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "cursor": { "type": ["string", "null"], "maxLength": 4096 }
      }
    }
  }
}
