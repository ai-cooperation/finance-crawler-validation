{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finance-crawler.example/schemas/professional-equity-report.schema.json",
  "title": "Human-first professional equity research report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "report_level", "generated_at", "target", "decision_card", "executive_summary", "chapters", "appendix", "quality_gates", "disclosures"],
  "properties": {
    "schema_version": {"const": 2},
    "report_id": {"type": "string", "minLength": 8},
    "report_level": {"enum": ["L1", "L2", "L3"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "target": {"type": "object", "additionalProperties": true, "required": ["symbol", "name", "market", "currency"]},
    "decision_card": {"type": "object", "additionalProperties": true, "required": ["rating", "market_price", "target_range", "horizon", "confidence"]},
    "executive_summary": {"type": "object", "additionalProperties": true, "required": ["theses", "catalysts", "risks", "monitoring"]},
    "chapters": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"type": "object", "additionalProperties": true, "required": ["id", "title", "status", "content"]}},
    "appendix": {"type": "object", "additionalProperties": true, "required": ["evidence", "calculations", "unresolved", "run_metadata"]},
    "quality_gates": {"type": "object", "additionalProperties": true},
    "disclosures": {"type": "object", "additionalProperties": true, "required": ["investment_advice", "conflicts", "model_responsibility"]}
  }
}
