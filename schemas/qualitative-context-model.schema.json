{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finance-crawler.example/schemas/qualitative-context-model.schema.json",
  "title": "Validated target-scoped qualitative context model run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "target_id", "model", "input_sha256", "generated_at", "input_summary", "validation", "result"],
  "properties": {
    "schema_version": {"const": "qualitative-context-model-run.v1"},
    "run_id": {"type": "string", "minLength": 8},
    "target_id": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "endpoint": {"type": "string"},
    "prompt_template": {"type": "string"},
    "prompt_template_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "raw_response_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "revalidated_at": {"type": "string", "format": "date-time"},
    "input_summary": {"type": "object", "additionalProperties": true},
    "usage": {"type": ["object", "null"], "additionalProperties": true},
    "validation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "target_match", "as_of_match", "required_sections", "dangling_evidence_ids"],
      "properties": {
        "status": {"enum": ["pass", "fail"]},
        "target_match": {"type": "boolean"},
        "as_of_match": {"type": "boolean"},
        "required_sections": {"type": "boolean"},
        "dangling_evidence_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "result": {"$ref": "https://finance-crawler.example/schemas/qualitative-context-result.schema.json"}
  }
}
