{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finance-crawler.example/schemas/research-gap-plan.schema.json",
  "title": "Material evidence gap route plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_id", "question_sha256", "industry_family", "generated_at", "round", "status", "attempted_route_ids", "gaps", "routes"],
  "properties": {
    "schema_version": {"const": 1},
    "target_id": {"type": "string", "minLength": 1},
    "question_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "industry_family": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "round": {"type": "integer", "minimum": 1, "maximum": 4},
    "status": {"enum": ["planned", "no_action"]},
    "attempted_route_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "parent_question_id", "section", "status", "decision_materiality", "priority", "missing_metrics", "missing_roles", "missing_geographies", "conflicts", "expected_information_gain", "attempted_routes", "remaining_routes"],
        "properties": {
          "requirement_id": {"type": "string"},
          "parent_question_id": {"type": "string"},
          "section": {"type": "string"},
          "status": {"enum": ["partial", "unresolved"]},
          "decision_materiality": {"enum": ["high", "medium"]},
          "priority": {"type": "number", "minimum": 0, "maximum": 1},
          "missing_metrics": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "missing_roles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "missing_geographies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "conflicts": {"type": "array", "items": {}},
          "expected_information_gain": {"type": "number", "minimum": 0, "maximum": 1},
          "attempted_routes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "remaining_routes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route_id", "url", "section", "transport", "requirement_ids", "evidence_roles", "independence_groups", "priority", "fallback_rank", "reason"],
        "properties": {
          "route_id": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "section": {"type": "string"},
          "transport": {"enum": ["api", "rss", "browser"]},
          "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "evidence_roles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "independence_groups": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "priority": {"type": "number", "minimum": 0, "maximum": 1},
          "fallback_rank": {"type": "integer", "minimum": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "provider_candidates": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider_id", "rank_score", "covered_metric_count", "matched_metric_support", "transport", "adapter", "endpoint_template", "missing_parameters", "callable_now", "blocked_reasons"],
          "properties": {
            "provider_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,127}$"},
            "rank_score": {"type": "integer", "minimum": 0},
            "covered_metric_count": {"type": "integer", "minimum": 0},
            "matched_metric_support": {
              "type": "object",
              "additionalProperties": {"enum": ["exact", "derived", "proxy"]}
            },
            "transport": {"enum": ["json_api", "rss", "browser", "file", "websocket", "python_library"]},
            "adapter": {"enum": ["generic_json", "generic_rss", "generic_browser", "provider_specific", "none"]},
            "endpoint_template": {"type": "string"},
            "auth_injection": {"enum": ["query_parameter", "header", "bearer_header", "provider_specific"]},
            "auth_field": {"type": "string", "minLength": 1, "maxLength": 128},
            "missing_parameters": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "callable_now": {"type": "boolean"},
            "blocked_reasons": {
              "type": "array",
              "uniqueItems": true,
              "items": {"enum": ["provider_not_callable", "credential_not_configured", "route_parameters_missing"]}
            }
          }
        }
      }
    }
  }
}
