{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finance-crawler.example/schemas/research-job.schema.json",
  "title": "Research report generator job request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "idempotency_key",
    "target",
    "requirements"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "operation": { "const": "submit_research_job" },
    "idempotency_key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$" },
    "target": { "$ref": "#/$defs/target" },
    "requirements": { "$ref": "#/$defs/requirements" }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["equity", "etf", "crypto", "company", "industry", "topic", "url"] },
        "symbol": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,32}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "market": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,32}$" },
        "url": { "type": "string", "format": "uri", "maxLength": 2000 }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "source_strategy",
        "include_market_data",
        "include_topic_radar",
        "report_profile",
        "max_sources"
      ],
      "properties": {
        "question": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "source_strategy": { "enum": ["latest_published", "actions"] },
        "include_market_data": { "type": "boolean" },
        "include_topic_radar": { "type": "boolean" },
        "report_profile": { "enum": ["detailed_traceable", "compact_traceable"] },
        "max_sources": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "collection_scope": { "enum": ["full_catalog", "legacy_smoke"] },
        "max_context_items": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "max_evidence_items": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "objective": { "enum": ["screen", "research", "monitor", "compare", "due_diligence", "meeting_battle_card", "decision_support"] },
        "as_of": { "type": "string", "minLength": 1, "maxLength": 64 },
        "horizon": { "enum": ["intraday", "days", "months", "years", "transaction"] },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "currency": { "type": "string", "maxLength": 16 },
            "risk_tolerance": { "type": "string", "maxLength": 64 },
            "jurisdiction": { "type": "string", "maxLength": 64 },
            "portfolio_context_ref": { "type": "string", "maxLength": 256 }
          }
        },
        "requested_outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["quick_card", "detailed_report", "evidence_appendix"] }
        }
      }
    }
  }
}
