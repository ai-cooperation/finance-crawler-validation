{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finance-crawler.example/schemas/soak-usage.schema.json",
  "title": "P0 Daily Soak Usage Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "captured_at",
    "window_started_at",
    "window_ended_at",
    "github_source",
    "github_repository",
    "github_repo_visibility",
    "workflow_run_id",
    "run_attempt",
    "commit_sha",
    "github_actions_runner_seconds",
    "github_actions_billable_seconds",
    "cloudflare_source",
    "cloudflare_analytics_scope",
    "cloudflare_account_id",
    "worker_script",
    "d1_database_id",
    "r2_bucket",
    "worker_requests",
    "d1_rows_read",
    "d1_rows_written",
    "r2_class_a_operations",
    "r2_class_b_operations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "captured_at": { "type": "string", "format": "date-time" },
    "window_started_at": { "type": "string", "format": "date-time" },
    "window_ended_at": { "type": "string", "format": "date-time" },
    "github_source": { "const": "github_api" },
    "github_repository": { "const": "ai-cooperation/finance-crawler-validation" },
    "github_repo_visibility": { "const": "public" },
    "workflow_run_id": { "type": "string", "pattern": "^[0-9]+$" },
    "run_attempt": { "type": "integer", "minimum": 1 },
    "commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "github_actions_runner_seconds": { "type": "integer", "minimum": 1 },
    "github_actions_billable_seconds": { "const": 0 },
    "cloudflare_source": { "const": "cloudflare_graphql" },
    "cloudflare_analytics_scope": { "const": "observed_not_billing" },
    "cloudflare_account_id": { "const": "ca985c195ab218488fc0744692dbde21" },
    "worker_script": { "const": "finance-crawler-validation-ingest" },
    "d1_database_id": { "const": "476bd84f-e924-4b9b-a9d9-dfca9ea29a1a" },
    "r2_bucket": { "const": "finance-crawler-validation-raw" },
    "worker_requests": { "type": "integer", "minimum": 1 },
    "d1_rows_read": { "type": "integer", "minimum": 1 },
    "d1_rows_written": { "type": "integer", "minimum": 1 },
    "r2_class_a_operations": { "type": "integer", "minimum": 1 },
    "r2_class_b_operations": { "type": "integer", "minimum": 1 }
  }
}
