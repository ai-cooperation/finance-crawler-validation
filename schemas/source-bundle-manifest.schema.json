{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finance-crawler.example/schemas/source-bundle-manifest.schema.json",
  "title": "Research source bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "requirement_id",
    "strategy",
    "source_ids",
    "source_count",
    "collection_scope",
    "source_catalogs",
    "expected_endpoint_count",
    "expected_source_group_count",
    "layers",
    "sufficiency",
    "missing_data",
    "planner_version",
    "generated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "manifest_id": { "type": "string", "pattern": "^[a-z][a-z0-9_:-]{7,127}$" },
    "requirement_id": { "type": "string", "pattern": "^[a-z][a-z0-9_:-]{7,127}$" },
    "strategy": { "enum": ["reuse", "refresh", "blocked"] },
    "source_ids": { "type": "array", "uniqueItems": true, "maxItems": 256, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]{0,99}$" } },
    "source_count": { "type": "integer", "minimum": 0, "maximum": 256 },
    "collection_scope": { "enum": ["full_catalog", "legacy_smoke"] },
    "source_catalogs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9_]{2,32}$" } },
    "expected_endpoint_count": { "type": "integer", "minimum": 0, "maximum": 512 },
    "expected_source_group_count": { "type": "integer", "minimum": 0, "maximum": 256 },
    "layers": { "type": "array", "uniqueItems": true, "items": { "enum": ["market", "news", "official", "social"] } },
    "reused_snapshot_id": { "type": ["string", "null"] },
    "missing_data": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "sufficiency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "coverage_ratio", "reasons"],
      "properties": {
        "status": { "enum": ["sufficient", "refresh_required", "blocked"] },
        "coverage_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "reasons": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "planner_version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "reason": { "enum": ["explicit_refresh", "sufficiency_refresh_required", "reuse_latest_published", "document_engine_required", "source_budget_too_low", "market_target_not_supported"] }
  }
}
