{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finance-crawler.example/schemas/source-registry.schema.json",
  "title": "Shared source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "sources"],
  "properties": {
    "schema_version": { "const": 1 },
    "registry_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,127}$" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "publisher_id", "source_tier", "independence_group", "transport", "canonical_url"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,127}$" },
        "publisher_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,127}$" },
        "source_tier": { "enum": ["official", "regulatory", "direct_primary", "direct_secondary", "aggregator", "unknown"] },
        "independence_group": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,127}$" },
        "transport": { "enum": ["browser", "json_api", "rss", "static_html", "file"] },
        "canonical_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "region": { "type": "string", "minLength": 2 },
        "language": { "type": "string", "minLength": 2 },
        "priority": { "type": "integer", "minimum": 1 },
        "access_tier": { "type": "string", "minLength": 2 },
        "route_role": { "type": "string", "minLength": 2 },
        "rights": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
