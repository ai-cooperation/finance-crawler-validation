{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finance-crawler.example/schemas/tradingagents-run-plan.schema.json",
  "title": "Bounded TradingAgents second-opinion run plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "topic_snapshot_id",
    "alignment_id",
    "created_at",
    "decision",
    "skip_reason",
    "budget",
    "topics"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "plan_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{7,127}$" },
    "topic_snapshot_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{7,127}$" },
    "alignment_id": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{7,127}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "decision": { "enum": ["eligible", "skipped"] },
    "skip_reason": {
      "enum": ["none", "no_topics", "missing_market_alignment", "no_budget"]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_topics", "max_claims_per_topic", "max_tokens", "max_usd", "model"],
      "properties": {
        "max_topics": { "type": "integer", "minimum": 0, "maximum": 3 },
        "max_claims_per_topic": { "type": "integer", "minimum": 1, "maximum": 20 },
        "max_tokens": { "type": "integer", "minimum": 1, "maximum": 200000 },
        "max_usd": { "type": "number", "minimum": 0 },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "topics": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/topic" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic_id",
        "label",
        "score",
        "decision",
        "reason",
        "market_direction",
        "evidence_ids"
      ],
      "properties": {
        "topic_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "score": { "type": "number", "minimum": 0 },
        "decision": { "enum": ["run", "skip"] },
        "reason": {
          "enum": ["top_ranked", "divergence", "user_requested", "budget_cap", "not_requested"]
        },
        "market_direction": {
          "enum": ["positive", "negative", "mixed", "not_covered"]
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  }
}
