{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "finance-crawler-feed-relay",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "finance-crawler-feed-relay-staging"
    }
  }
}
